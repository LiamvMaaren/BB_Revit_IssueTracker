<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BB Issue Tracker — Issuedetail"
        Width="1180"
        Height="780"
        MinWidth="960"
        MinHeight="640"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        Background="#F2F5F7">
    <Window.Resources>
        <SolidColorBrush x:Key="PrimaryBrush" Color="#0B627D"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#D5E0E6"/>
        <SolidColorBrush x:Key="InputBorderBrush" Color="#9EB7C5"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#607382"/>
        <SolidColorBrush x:Key="TextBrush" Color="#183142"/>

        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        </Style>
        <Style TargetType="Label">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#294453"/>
            <Setter Property="Padding" Value="1,0,0,4"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="Padding" Value="9,6"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="#F7FBFD"/>
            <Setter Property="BorderBrush" Value="{StaticResource InputBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="Padding" Value="7,5"/>
            <Setter Property="Background" Value="#F7FBFD"/>
            <Setter Property="BorderBrush" Value="{StaticResource InputBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style TargetType="DatePicker">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="Background" Value="#F7FBFD"/>
            <Setter Property="BorderBrush" Value="{StaticResource InputBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="13,7"/>
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#294453"/>
            <Setter Property="BorderBrush" Value="#B8C8D1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="PreviewButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="9,5"/>
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="Margin" Value="0,0,7,7"/>
            <Setter Property="Background" Value="#F8FBFC"/>
        </Style>
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="13"/>
        </Style>
        <Style TargetType="ListBox">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="58"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="15,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="38" Height="38" Background="{StaticResource PrimaryBrush}" CornerRadius="5" Margin="0,0,11,0">
                        <TextBlock Text="BB" Foreground="White" FontWeight="Bold" FontSize="14"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="detail_issue_id" Text="Nieuw issue" FontSize="17" FontWeight="SemiBold"/>
                            <TextBlock Text="  ·  " Foreground="{StaticResource MutedBrush}" FontSize="15"/>
                            <TextBlock x:Name="detail_header_title" Text="Issuedetail" FontSize="17"
                                       FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="650"/>
                        </StackPanel>
                        <TextBlock x:Name="detail_metadata" Text="Nog niet opgeslagen"
                                   Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,3,0,0"/>
                    </StackPanel>
                </StackPanel>
                <Border Grid.Column="1" x:Name="dirty_indicator" Visibility="Collapsed"
                        Background="#FFF4E8" BorderBrush="#E6A14C" BorderThickness="1"
                        CornerRadius="5" Padding="9,4" VerticalAlignment="Center">
                    <TextBlock Text="Niet opgeslagen" Foreground="#9A5700" FontSize="11" FontWeight="SemiBold"/>
                </Border>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="42*" MinWidth="360"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="58*" MinWidth="510"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,10">
                        <StackPanel>
                            <Grid Margin="0,0,0,9">
                                <TextBlock Text="SNAPSHOT" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{StaticResource MutedBrush}"/>
                                <TextBlock x:Name="snapshot_count_text" Text="Hoofdpreview"
                                           HorizontalAlignment="Right" FontSize="10"
                                           Foreground="{StaticResource MutedBrush}"/>
                            </Grid>
                            <Border Height="350" Background="#EEF3F5"
                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                    CornerRadius="6" ClipToBounds="True">
                                <Grid>
                                    <Image x:Name="preview_image" Stretch="Uniform"/>
                                    <TextBlock x:Name="preview_empty_text" Text="Nog geen snapshot"
                                               Foreground="{StaticResource MutedBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                            <WrapPanel Margin="0,10,0,0">
                                <Button Content="Naar locatie" Style="{StaticResource PreviewButton}" Click="open_location_click"/>
                                <Button x:Name="pick_location_button" Content="Locatie wijzigen"
                                        Style="{StaticResource PreviewButton}" Click="pick_location_click"/>
                                <Button x:Name="capture_snapshot_button" Content="Nieuwe snapshot"
                                        Style="{StaticResource PreviewButton}" Click="capture_snapshot_click"/>
                                <Button Content="Open previewview" Style="{StaticResource PreviewButton}"
                                        Click="open_preview_view_click"/>
                                <Button x:Name="choose_image_button" Content="Afbeelding kiezen"
                                        Style="{StaticResource PreviewButton}" Click="choose_image_click"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="LOCATIE EN BRON" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{StaticResource MutedBrush}" Margin="0,0,0,10"/>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="118"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Issue-locatie" FontWeight="SemiBold" FontSize="11"/>
                                <TextBlock Grid.Column="1" x:Name="location_text" Text="Niet gekozen"
                                           FontSize="11" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Grid.Row="1" Text="Snapshotbron" FontWeight="SemiBold"
                                           FontSize="11" Margin="0,7,0,0"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" x:Name="snapshot_source_text"
                                           Text="Niet gekozen" FontSize="11" Margin="0,7,0,0"
                                           TextTrimming="CharacterEllipsis"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="ISSUEGEGEVENS" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{StaticResource MutedBrush}" Margin="0,0,0,10"/>

                            <Label Content="TITEL"/>
                            <TextBox x:Name="title_text" TextChanged="editor_changed" Margin="0,0,0,10"/>

                            <Label Content="OMSCHRIJVING"/>
                            <TextBox x:Name="description_text" AcceptsReturn="True" TextWrapping="Wrap"
                                     MinHeight="105" VerticalContentAlignment="Top"
                                     TextChanged="editor_changed" Margin="0,0,0,10"/>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <Label Content="TOEGEWEZEN AAN"/>
                                    <ComboBox x:Name="assigned_combo" DisplayMemberPath="Label" SelectedValuePath="Key"
                                              SelectionChanged="editor_changed"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <Label Content="STATUS"/>
                                    <ComboBox x:Name="status_combo" DisplayMemberPath="Label" SelectedValuePath="Key"
                                              SelectionChanged="editor_changed"/>
                                </StackPanel>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <Label Content="PRIORITEIT"/>
                                    <ComboBox x:Name="priority_combo" DisplayMemberPath="Label" SelectedValuePath="Key"
                                              SelectionChanged="editor_changed"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <Label Content="TYPE"/>
                                    <ComboBox x:Name="type_combo" DisplayMemberPath="Label" SelectedValuePath="Key"
                                              SelectionChanged="editor_changed"/>
                                </StackPanel>
                                <StackPanel Grid.Column="4">
                                    <Label Content="DEADLINE"/>
                                    <DatePicker x:Name="due_date_picker" SelectedDateChanged="editor_changed"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="PROJECTCONTEXT" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{StaticResource MutedBrush}" Margin="0,0,0,10"/>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="105"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="105"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Project" FontWeight="SemiBold" FontSize="11"/>
                                <TextBlock Grid.Column="1" x:Name="detail_project_text" FontSize="11"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock Grid.Column="2" Text="Model" FontWeight="SemiBold" FontSize="11"/>
                                <TextBlock Grid.Column="3" x:Name="detail_model_text" FontSize="11"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock Grid.Row="1" Text="Aangemaakt door" FontWeight="SemiBold"
                                           FontSize="11" Margin="0,7,0,0"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" x:Name="detail_created_by_text"
                                           FontSize="11" Margin="0,7,0,0"/>
                                <TextBlock Grid.Row="1" Grid.Column="2" Text="Aangemaakt" FontWeight="SemiBold"
                                           FontSize="11" Margin="0,7,0,0"/>
                                <TextBlock Grid.Row="1" Grid.Column="3" x:Name="detail_created_text"
                                           FontSize="11" Margin="0,7,0,0"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="OPMERKINGEN" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{StaticResource MutedBrush}" Margin="0,0,0,8"/>
                            <TextBlock Grid.Column="2" Text="HISTORIE" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{StaticResource MutedBrush}" Margin="0,0,0,8"/>
                            <ListBox Grid.Row="1" x:Name="comments_list" MinHeight="88" MaxHeight="145"/>
                            <ListBox Grid.Row="1" Grid.Column="2" x:Name="history_list" MinHeight="88" MaxHeight="145"/>
                            <TextBox Grid.Row="2" x:Name="new_comment_text" AcceptsReturn="True" TextWrapping="Wrap"
                                     MinHeight="54" VerticalContentAlignment="Top" Margin="0,9,0,0"
                                     ToolTip="Nieuwe opmerking"/>
                            <Button Grid.Row="3" x:Name="add_comment_button" Content="+  Opmerking toevoegen"
                                    HorizontalAlignment="Left" Margin="0,8,0,0"
                                    Style="{StaticResource SecondaryButton}" Click="add_comment_click"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <Grid Margin="12,9">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="detail_status_text" Text="Gereed" Foreground="{StaticResource MutedBrush}"
                               FontSize="11" VerticalAlignment="Center"/>
                    <Ellipse x:Name="detail_network_dot" Width="7" Height="7" Fill="#98A2B3"
                             Margin="16,0,5,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="detail_network_text" Text="Netwerk onbekend"
                               Foreground="{StaticResource MutedBrush}" FontSize="11" VerticalAlignment="Center"/>
                </StackPanel>
                <Button Grid.Column="1" Content="Wijzigingen herstellen"
                        Style="{StaticResource SecondaryButton}" Click="cancel_changes_click"/>
                <Button Grid.Column="3" x:Name="save_button" Content="Opslaan" MinWidth="110"
                        Style="{StaticResource PrimaryButton}" Click="save_click"/>
                <Button Grid.Column="5" Content="Sluiten"
                        Style="{StaticResource SecondaryButton}" Click="close_click"/>
            </Grid>
        </Border>
    </Grid>
</Window>
