<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BB Issue Tracker"
        Width="560"
        Height="310"
        MinWidth="520"
        MinHeight="290"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="#F2F5F7">
    <Window.Resources>
        <SolidColorBrush x:Key="PrimaryBrush" Color="#0B627D"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#D5E0E6"/>
        <SolidColorBrush x:Key="TextBrush" Color="#183142"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#607382"/>
        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        </Style>
        <Style x:Key="ChoiceButton" TargetType="Button">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="MinHeight" Value="48"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#294453"/>
            <Setter Property="BorderBrush" Value="#B8C8D1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="PrimaryChoiceButton" TargetType="Button" BasedOn="{StaticResource ChoiceButton}">
            <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
        </Style>
        <Style x:Key="CancelButton" TargetType="Button">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Background" Value="#F8FBFC"/>
            <Setter Property="Foreground" Value="#405A69"/>
            <Setter Property="BorderBrush" Value="#B8C8D1"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Background="White" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1" CornerRadius="8" Padding="13" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal">
                <Border Width="38" Height="38" Background="{StaticResource PrimaryBrush}"
                        CornerRadius="5" Margin="0,0,11,0">
                    <TextBlock Text="BB" Foreground="White" FontWeight="Bold" FontSize="14"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="BB Issue Tracker" FontSize="17" FontWeight="SemiBold"/>
                    <TextBlock Text="Kies hoe je wilt beginnen" Foreground="{StaticResource MutedBrush}"
                               FontSize="11" Margin="0,2,0,0"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Background="White" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1" CornerRadius="8" Padding="13">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Issues zoeken, filteren en openen."
                               Foreground="{StaticResource MutedBrush}" FontSize="11"
                               TextWrapping="Wrap" Margin="2,0,2,8"/>
                    <Button Content="Dashboard openen"
                            Style="{StaticResource ChoiceButton}"
                            Click="dashboard_click"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Leg direct een nieuw controlepunt vast."
                               Foreground="{StaticResource MutedBrush}" FontSize="11"
                               TextWrapping="Wrap" Margin="2,0,2,8"/>
                    <Button Content="+  Nieuwe issue maken"
                            Style="{StaticResource PrimaryChoiceButton}"
                            Click="new_issue_click"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="0,10,0,0">
            <TextBlock Text="Issuedetails openen in een afzonderlijk modeless venster."
                       Foreground="{StaticResource MutedBrush}" FontSize="10"
                       VerticalAlignment="Center"/>
            <Button Content="Annuleren" HorizontalAlignment="Right"
                    Style="{StaticResource CancelButton}" Click="cancel_click"/>
        </Grid>
    </Grid>
</Window>
