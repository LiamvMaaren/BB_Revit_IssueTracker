<Page xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#F2F5F7"
      MinWidth="300"
      MinHeight="260">
    <Grid>
        <Frame x:Name="content_host"
               NavigationUIVisibility="Hidden"
               Background="#F2F5F7"/>
        <Border x:Name="placeholder" Background="#F2F5F7" Padding="12">
            <Border Background="White" BorderBrush="#D5E0E6" BorderThickness="1"
                    CornerRadius="8" Padding="20">
                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            MaxWidth="360">
                    <Border Width="44" Height="44" Background="#0B627D"
                            CornerRadius="6" HorizontalAlignment="Center"
                            Margin="0,0,0,13">
                        <TextBlock Text="BB" Foreground="White" FontWeight="Bold"
                                   FontSize="16" HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock x:Name="loading_text"
                               Text="Open de BB Issue Tracker via de toolbar."
                               FontFamily="Segoe UI" FontSize="14"
                               FontWeight="SemiBold" Foreground="#183142"
                               TextAlignment="Center" TextWrapping="Wrap"/>
                    <TextBlock x:Name="error_text" Text="" Margin="0,8,0,0"
                               FontFamily="Segoe UI" FontSize="11"
                               Foreground="#B42318" TextAlignment="Center"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</Page>
