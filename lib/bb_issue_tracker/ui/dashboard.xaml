<Page xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#F2F5F7"
      MinWidth="300"
      MinHeight="520">
    <Page.Resources>
        <SolidColorBrush x:Key="PrimaryBrush" Color="#0B627D"/>
        <SolidColorBrush x:Key="PrimaryDarkBrush" Color="#084D63"/>
        <SolidColorBrush x:Key="PanelBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#D5E0E6"/>
        <SolidColorBrush x:Key="InputBorderBrush" Color="#AFC2CD"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#607382"/>
        <SolidColorBrush x:Key="TextBrush" Color="#183142"/>

        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        </Style>
        <Style TargetType="Label">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="1,0,0,4"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="#F8FBFC"/>
            <Setter Property="BorderBrush" Value="{StaticResource InputBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Background" Value="#F8FBFC"/>
            <Setter Property="BorderBrush" Value="{StaticResource InputBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="11,6"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#294453"/>
            <Setter Property="BorderBrush" Value="#B8C8D1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="SubtleButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="Padding" Value="7,4"/>
            <Setter Property="MinHeight" Value="27"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Background" Value="#F8FBFC"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#405A69"/>
            <Setter Property="Margin" Value="0,0,0,7"/>
        </Style>
        <Style TargetType="Expander">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        </Style>
        <Style x:Key="IssueListItemStyle" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,0,7"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Card"
                                Background="White"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="7"
                                Padding="11,9">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Card" Property="Background" Value="#EAF5F8"/>
                                <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                                <Setter TargetName="Card" Property="BorderThickness" Value="2"/>
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Card" Property="BorderBrush" Value="#83A9B8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid Margin="9">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="28"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="White"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="12"
                Margin="0,0,0,9">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <Border Width="34" Height="34" Background="{StaticResource PrimaryBrush}" CornerRadius="5" Margin="0,0,9,0">
                        <TextBlock Text="BB" Foreground="White" FontWeight="Bold" FontSize="13"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Issue Tracker" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock x:Name="project_context_text" Text="Geen actief project"
                                   Foreground="{StaticResource MutedBrush}" FontSize="10"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </StackPanel>
                <Button Grid.Column="1" Content="↻" Width="34" Height="34" Padding="0"
                        FontSize="16" ToolTip="Verversen"
                        Style="{StaticResource SecondaryButton}" Click="refresh_click"/>
                <Button Grid.Row="1" Grid.ColumnSpan="2" x:Name="new_issue_button"
                        Content="+  Nieuw issue" Margin="0,11,0,0"
                        Style="{StaticResource PrimaryButton}" Click="new_issue_click"/>
            </Grid>
        </Border>

        <Border Grid.Row="1"
                Background="White"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="11"
                Margin="0,0,0,9">
            <StackPanel>
                <Label Content="ZOEKEN"/>
                <TextBox x:Name="search_text"
                         ToolTip="Zoek op nummer, titel, omschrijving, view of opmerking"
                         TextChanged="search_changed"
                         Margin="0,0,0,9"/>
                <Expander Header="Filters" IsExpanded="False">
                    <Grid Margin="0,9,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Row="0" Grid.ColumnSpan="3" Margin="0,0,0,8">
                            <Label Content="PROJECT"/>
                            <ComboBox x:Name="project_filter" DisplayMemberPath="Label" SelectedValuePath="Key"
                                      SelectionChanged="filter_changed"/>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Margin="0,0,0,8">
                            <Label Content="PERSOON"/>
                            <ComboBox x:Name="person_filter" DisplayMemberPath="Label" SelectedValuePath="Key"
                                      SelectionChanged="filter_changed"/>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,8">
                            <Label Content="STATUS"/>
                            <ComboBox x:Name="status_filter" DisplayMemberPath="Label" SelectedValuePath="Key"
                                      SelectionChanged="filter_changed"/>
                        </StackPanel>
                        <StackPanel Grid.Row="2" Margin="0,0,0,8">
                            <Label Content="PRIORITEIT"/>
                            <ComboBox x:Name="priority_filter" DisplayMemberPath="Label" SelectedValuePath="Key"
                                      SelectionChanged="filter_changed"/>
                        </StackPanel>
                        <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,0,0,8">
                            <Label Content="TYPE"/>
                            <ComboBox x:Name="type_filter" DisplayMemberPath="Label" SelectedValuePath="Key"
                                      SelectionChanged="filter_changed"/>
                        </StackPanel>
                        <WrapPanel Grid.Row="3" Grid.ColumnSpan="3">
                            <CheckBox x:Name="my_issues_toggle" Content="Mijn issues"
                                      Checked="filter_changed" Unchecked="filter_changed" Margin="0,0,14,7"/>
                            <CheckBox x:Name="created_by_me_toggle" Content="Door mij aangemaakt"
                                      Checked="filter_changed" Unchecked="filter_changed" Margin="0,0,14,7"/>
                            <CheckBox x:Name="overdue_toggle" Content="Over deadline"
                                      Checked="filter_changed" Unchecked="filter_changed" Margin="0,0,14,7"/>
                            <CheckBox x:Name="active_view_toggle" Content="Alleen actieve view"
                                      Checked="filter_changed" Unchecked="filter_changed"/>
                        </WrapPanel>
                        <Button Grid.Row="4" Grid.ColumnSpan="3" Content="Filters wissen"
                                HorizontalAlignment="Left"
                                Style="{StaticResource SubtleButton}" Click="reset_filters_click"/>
                    </Grid>
                </Expander>
            </StackPanel>
        </Border>

        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid Margin="3,0,3,6">
                <TextBlock Text="ISSUES" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}"/>
                <TextBlock x:Name="issue_count_text" HorizontalAlignment="Right" FontSize="11"
                           Foreground="{StaticResource MutedBrush}"/>
            </Grid>
            <ListBox Grid.Row="1"
                     x:Name="issue_grid"
                     Background="Transparent"
                     BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ItemContainerStyle="{StaticResource IssueListItemStyle}"
                     SelectionChanged="issue_selection_changed"
                     MouseDoubleClick="issue_double_click">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Id}" FontWeight="SemiBold" FontSize="12"/>
                            <Border Grid.Column="1" Background="{Binding StatusBackground}"
                                    BorderBrush="{Binding StatusBorder}" BorderThickness="1"
                                    CornerRadius="4" Padding="6,2">
                                <TextBlock Text="{Binding Status}" Foreground="{Binding StatusForeground}" FontSize="10"/>
                            </Border>
                            <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding Title}"
                                       FontSize="12" Margin="0,5,0,6" TextWrapping="Wrap"
                                       TextTrimming="CharacterEllipsis" MaxHeight="38"/>
                            <Grid Grid.Row="2" Grid.ColumnSpan="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Assigned}" Foreground="{StaticResource MutedBrush}"
                                           FontSize="10" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Grid.Column="1" Text="{Binding Footer}" Foreground="{StaticResource MutedBrush}"
                                           FontSize="10" Margin="8,0,0,0"/>
                            </Grid>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>

        <Border Grid.Row="3"
                Background="White"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="10"
                Margin="0,9,0,9">
            <Grid>
                <TextBlock x:Name="selected_empty_text"
                           Text="Selecteer een issue voor een korte preview."
                           Foreground="{StaticResource MutedBrush}"
                           TextWrapping="Wrap"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Margin="8"/>
                <Grid x:Name="selected_issue_content" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="88"/>
                        <ColumnDefinition Width="9"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="88" Height="68" Background="#EEF3F5"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                            CornerRadius="4" ClipToBounds="True">
                        <Grid>
                            <Image x:Name="browser_preview_image" Stretch="UniformToFill"/>
                            <TextBlock x:Name="browser_preview_empty" Text="Geen beeld"
                                       Foreground="{StaticResource MutedBrush}" FontSize="10"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <StackPanel Grid.Column="2">
                        <TextBlock x:Name="browser_selected_id" FontWeight="SemiBold" FontSize="12"/>
                        <TextBlock x:Name="browser_selected_title" FontSize="11" TextWrapping="Wrap"
                                   TextTrimming="CharacterEllipsis" MaxHeight="34" Margin="0,3,0,3"/>
                        <TextBlock x:Name="browser_selected_meta" Foreground="{StaticResource MutedBrush}"
                                   FontSize="10" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <TextBlock Grid.Row="1" Grid.ColumnSpan="3" x:Name="browser_selected_status"
                               Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,7,0,7"/>
                    <Grid Grid.Row="2" Grid.ColumnSpan="3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="7"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="open_detail_button" Content="Open issue"
                                Style="{StaticResource SecondaryButton}" Click="open_selected_issue_click"/>
                        <Button x:Name="browser_location_button" Grid.Column="2" Content="Naar locatie"
                                Style="{StaticResource PrimaryButton}" Click="browser_open_location_click"/>
                    </Grid>
                </Grid>
            </Grid>
        </Border>

        <Border Grid.Row="4" Background="#F7FAFB" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1" CornerRadius="5">
            <Grid Margin="8,0">
                <TextBlock x:Name="status_text" Text="Gereed" VerticalAlignment="Center"
                           Foreground="{StaticResource MutedBrush}" FontSize="10"
                           Margin="0,0,215,0" TextTrimming="CharacterEllipsis"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Ellipse x:Name="marker_dot" Width="7" Height="7" Fill="#98A2B3" Margin="0,0,5,0"/>
                    <TextBlock x:Name="marker_text" Text="Markers: 0"
                               Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,0,12,0"/>
                    <Ellipse x:Name="network_dot" Width="7" Height="7" Fill="#98A2B3" Margin="0,0,5,0"/>
                    <TextBlock x:Name="network_text" Text="Netwerk onbekend"
                               Foreground="{StaticResource MutedBrush}" FontSize="10"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>
